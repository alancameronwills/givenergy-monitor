# GivEnergy monitor configuration.
# .env is created/updated automatically by the startup scan (server.js). This file
# documents the recognised variables; copy to .env only if you want to override.

# --- Inverter connection (auto-discovered on startup) ---
INVERTER_HOST=192.168.1.100
INVERTER_PORT=8899
INVERTER_AIO=false
NUM_BATTERIES=1
API_PORT=6345

# --- History logging (src/history.js) ---
# How often the sampler reads and logs the inverter (ms). Default 300000 (5 min).
SAMPLE_INTERVAL_MS=300000
# Where per-day detail (JSONL) and daily.json live. Relative to project root.
DATA_DIR=./data
# Days of per-sample detail files to keep before pruning. Default 7.
DETAIL_RETENTION_DAYS=7
# Days of daily-summary entries to keep before pruning. Default 366.
SUMMARY_RETENTION_DAYS=366
